{
  "Comment": "Advance downstream batch stages for one owned ingestion",
  "StartAt": "SelectEntry",
  "TimeoutSeconds": 900,
  "States": {
    "SelectEntry": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.mode",
          "StringEquals": "batch",
          "Next": "SetUpstreamActions"
        },
        {
          "Variable": "$.mode",
          "StringEquals": "resume_publication",
          "Next": "RenewBeforePublication"
        }
      ],
      "Default": "InvalidEntryMode"
    },
    "InvalidEntryMode": {
      "Type": "Fail",
      "Error": "InvalidBatchEntryMode",
      "Cause": "Expected batch or resume_publication"
    },
    "SetUpstreamActions": {
      "Type": "Pass",
      "Result": [
        "advance_processing",
        "advance_raw_history"
      ],
      "ResultPath": "$.upstream_actions",
      "Next": "RenewBeforeUpstream"
    },
    "RunUpstreamStages": {
      "Type": "Map",
      "ItemsPath": "$.upstream_actions",
      "MaxConcurrency": 2,
      "ItemSelector": {
        "request": {
          "request_version": 1,
          "action.$": "$$.Map.Item.Value",
          "ingestion_id.$": "$.ingestion_id",
          "ingestion_owner.$": "$.ingestion_owner"
        }
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "AdvanceUpstreamStage",
        "States": {
          "AdvanceUpstreamStage": {
            "Type": "Task",
            "Resource": "${batch_lambda_arn}",
            "InputPath": "$.request",
            "TimeoutSeconds": 60,
            "End": true
          }
        }
      },
      "ResultPath": "$.upstream_results",
      "Next": "CheckUpstreamStages"
    },
    "AdvancePublication": {
      "Type": "Task",
      "Resource": "${batch_lambda_arn}",
      "Parameters": {
        "request_version": 1,
        "action": "advance_publication",
        "ingestion_id.$": "$.ingestion_id",
        "ingestion_owner.$": "$.ingestion_owner"
      },
      "ResultPath": "$.publication_result",
      "TimeoutSeconds": 60,
      "Next": "CheckPublication"
    },
    "CheckPublication": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.publication_result.status",
          "StringEquals": "SUCCEEDED",
          "Next": "MarkBaselineReady"
        },
        {
          "Variable": "$.publication_result.status",
          "StringEquals": "RUNNING",
          "Next": "WaitForPublication"
        }
      ],
      "Default": "PublicationFailed"
    },
    "WaitForPublication": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "RenewBeforePublication"
    },
    "PublicationFailed": {
      "Type": "Fail",
      "Error": "BatchPublicationFailed",
      "CausePath": "States.Format('Publication did not complete for ingestion {}', $.ingestion_id)"
    },
    "MarkBaselineReady": {
      "Type": "Task",
      "Resource": "${batch_lambda_arn}",
      "Parameters": {
        "request_version": 1,
        "action": "mark_baseline_ready",
        "ingestion_id.$": "$.ingestion_id",
        "ingestion_owner.$": "$.ingestion_owner"
      },
      "TimeoutSeconds": 60,
      "End": true
    },
    "RenewBeforeUpstream": {
      "Type": "Task",
      "Resource": "${batch_lambda_arn}",
      "Parameters": {
        "request_version": 1,
        "action": "renew_ingestion_lease",
        "ingestion_id.$": "$.ingestion_id",
        "ingestion_owner.$": "$.ingestion_owner"
      },
      "ResultPath": null,
      "TimeoutSeconds": 60,
      "Next": "RunUpstreamStages"
    },
    "RenewBeforePublication": {
      "Type": "Task",
      "Resource": "${batch_lambda_arn}",
      "Parameters": {
        "request_version": 1,
        "action": "renew_ingestion_lease",
        "ingestion_id.$": "$.ingestion_id",
        "ingestion_owner.$": "$.ingestion_owner"
      },
      "ResultPath": null,
      "TimeoutSeconds": 60,
      "Next": "AdvancePublication"
    },
    "CheckUpstreamStages": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.upstream_results[0].status",
              "StringEquals": "SUCCEEDED"
            },
            {
              "Variable": "$.upstream_results[1].status",
              "StringEquals": "SUCCEEDED"
            }
          ],
          "Next": "RenewBeforePublication"
        },
        {
          "And": [
            {
              "Or": [
                {
                  "Variable": "$.upstream_results[0].status",
                  "StringEquals": "RUNNING"
                },
                {
                  "Variable": "$.upstream_results[0].status",
                  "StringEquals": "SUCCEEDED"
                }
              ]
            },
            {
              "Or": [
                {
                  "Variable": "$.upstream_results[1].status",
                  "StringEquals": "RUNNING"
                },
                {
                  "Variable": "$.upstream_results[1].status",
                  "StringEquals": "SUCCEEDED"
                }
              ]
            }
          ],
          "Next": "WaitForUpstreamStages"
        }
      ],
      "Default": "UpstreamStageFailed"
    },
    "WaitForUpstreamStages": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "RenewBeforeUpstream"
    },
    "UpstreamStageFailed": {
      "Type": "Fail",
      "Error": "BatchUpstreamStageFailed",
      "CausePath": "States.Format('Ingestion {} upstream statuses: Processing={}, Raw History={}', $.ingestion_id, $.upstream_results[0].status, $.upstream_results[1].status)"
    }
  }
}
